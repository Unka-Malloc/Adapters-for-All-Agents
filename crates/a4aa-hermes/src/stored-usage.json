{
  "root": "hermes-profile-store",
  "fileNames": ["state.db"],
  "sessions": {
    "table": "sessions",
    "id": "id",
    "model": "model",
    "startedAt": "started_at",
    "endedAt": "ended_at",
    "requests": "api_call_count",
    "tokens": {
      "input": "input_tokens",
      "output": "output_tokens",
      "cacheRead": "cache_read_tokens",
      "cacheWrite": "cache_write_tokens"
    }
  },
  "details": {
    "table": "session_model_usage",
    "session": "session_id",
    "model": "model",
    "task": "task",
    "firstSeen": "first_seen",
    "lastSeen": "last_seen",
    "requests": "api_call_count",
    "tokens": {
      "input": "input_tokens",
      "output": "output_tokens",
      "cacheRead": "cache_read_tokens",
      "cacheWrite": "cache_write_tokens"
    }
  },
  "activity": {
